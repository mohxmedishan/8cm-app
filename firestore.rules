rules_version = '2';

// 8CM is a read-only public site for now: no sign-in, no monitors, no writes.
// Edit features are on hold (see _on-hold/). Content is changed from the Firebase console.
// When editing returns, add a write rule per collection — do not widen the catch-all below.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{collection}/{doc=**} {
      allow read: if collection in [
        'students', 'teachers', 'assignments', 'notices', 'announcements',
        'events', 'achievements', 'gallery', 'pitchMatches'
      ];
      allow write: if false;
    }
  }
}
