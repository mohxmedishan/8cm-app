rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared admin check, used by every match block below: either the
    // allow-listed owner email, or a user whose own profile doc has
    // admin == true.
    function isAdmin() {
      return request.auth != null &&
        (
          request.auth.token.email == "mohamedishankunnummal@gmail.com" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        );
    }

    // Tasks: public — anyone, signed in or not, can read the daily
    // task/homework/announcement list. Only admins can write. The
    // `attachments` field here is just light metadata
    // ({id, name, type, size} per file) — the actual base64 bytes
    // live on the taskAttachments docs below, so no size guard is
    // needed on the task doc itself.
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Task attachments: there's no Firebase Storage on the Spark
    // (free) plan, so each attachment is its own small doc here —
    // {taskId, name, type, size, dataUrl, createdAt} — instead of a
    // Storage object. Public read (task attachments have always been
    // visible to everyone), admin-only write, and a hard cap on the
    // base64 payload so a single attachment can't approach
    // Firestore's ~1 MiB per-document limit. Splitting attachments
    // into their own docs (rather than embedding dataUrl arrays on
    // the task) is what lets multiple attachments per task each get
    // their own budget instead of sharing one.
    match /taskAttachments/{attachmentId} {
      allow read: if true;
      allow create: if isAdmin() &&
        request.resource.data.dataUrl is string &&
        request.resource.data.dataUrl.size() < 950000;
      allow delete: if isAdmin();
      allow update: if false; // immutable — remove and re-add instead of editing in place
    }

    // Gallery: public — the photo grid is visible to every visitor,
    // signed in or not. Only admins can add or remove photos. The
    // image itself is a base64 data: URL on the `dataUrl` field (no
    // Storage object to reference), capped the same way as task
    // attachments so a photo can't blow past the document size limit.
    match /gallery/{photoId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.dataUrl is string &&
        request.resource.data.dataUrl.size() < 950000;
      allow delete: if isAdmin();
    }

    // User profiles: any signed-in user can read (needed so the
    // identity-claim check can see who has already claimed which
    // student).
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId;

      // Admins can always fix a binding. A user can also write their
      // own doc, including changing claimedStudentId — that's the
      // "Switch student" feature in the UI. Uniqueness (no two
      // accounts on the same student) is enforced client-side via a
      // pre-write query (see findExistingClaim in auth.js), same as
      // it always was for the initial claim; it's a best-effort check
      // rather than a hard server-side guarantee, since Firestore
      // rules can't query "does any other doc already have this
      // value" without a dedicated claims collection keyed by
      // student id.
      allow update: if request.auth != null && (isAdmin() || request.auth.uid == userId);

      allow delete: if false;
    }
  }
}
