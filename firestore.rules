rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMonitor() {
      return signedIn() &&
        (request.auth.token.email == "mohamedishankunnummal@gmail.com" ||
         exists(/databases/$(database)/documents/monitors/$(request.auth.uid)));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMonitor());
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /claims/{studentId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        (!exists(/databases/$(database)/documents/claims/$(studentId)) ||
         resource.data.uid == request.auth.uid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /monitors/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMonitor());
      allow write: if isMonitor();
    }

    match /students/{id} {
      allow read: if signedIn();
      allow write: if isMonitor();
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isMonitor();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isMonitor();
    }

    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 280;
      allow update, delete: if isMonitor() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
