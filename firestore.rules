// ADD NEAR THE OTHER HELPERS
function isInvitedMonitor() {
  return isSignedIn() &&
    request.auth.token.email != null &&
    exists(/databases/$(database)/documents/monitorInvites/$(request.auth.token.email.lower()));
}

// REPLACE THE EXISTING isMonitor() WITH:
function isMonitor() {
  return isMonitorEmail() || isMonitorDoc() || isMonitorFlag() || isInvitedMonitor();
}

// ADD ALONGSIDE THE monitors/{uid} BLOCK:
match /monitorInvites/{email} {
  allow read: if isSignedIn();
  allow write: if isMonitor();
}
