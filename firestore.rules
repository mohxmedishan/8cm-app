rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Helpers
    // ================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Exactly 3 people are ever monitors for this class. Their emails
    // are a permanent bootstrap allowlist so there's always at least
    // one way to manage the `monitors` collection below without
    // anyone needing direct Firestore console access. Add the other
    // two monitors' emails here.
    // Lower-cased on both sides: the client-side mirror of this check
    // (emailMatchesAllowlist in auth.js) already normalizes case before
    // comparing, so a monitor's UI lit up as signed-in-and-monitor while
    // this rule — which compared the token's email byte-for-byte — could
    // still reject the write if Google/email sign-in preserved different
    // casing than what's hardcoded here. That mismatch is what made
    // homework/announcement saves fail for real monitors with no visible
    // reason. Comparing lower-cased on both sides matches the client and
    // removes the gap.
    function isMonitorEmail() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'mohamedishankunnummal@gmail.com',
        'shahbazshamsudheen713596@gmail.com'
      ];
    }

    // The dynamic path: a doc existing at monitors/{uid} IS the
    // monitor role for that account. Only monitors can write here
    // (see the match block below), so this can never be granted by
    // anyone other than an existing monitor.
    function isMonitorDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/monitors/$(request.auth.uid));
    }

    // The ONLY definition of "monitor" anywhere in this project.
    // Deliberately there is NO admin/monitor boolean field on
    // users/{uid} — a field like that is exactly what let a student
    // grant themselves access by editing their own profile doc. Role
    // lives here, and only here.
    function isMonitorFlag() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('monitor', false) == true;
    }

    // Monitor invites: lets an existing monitor grant the role to a
    // Gmail address BEFORE that person has ever signed in — at that
    // point their Firebase Auth uid doesn't exist yet, so it can't be
    // used as a monitors/{uid} doc ID the way the dynamic path above
    // is. The invite doc, keyed by the lowercased email itself, IS
    // the grant: once that address signs in, isMonitor() recognizes
    // it immediately via isInvitedMonitorEmail() below. Restricted to
    // @gmail.com by the create rule itself, not just the "Add
    // monitor" form's client-side input — same lower-cased comparison
    // approach as isMonitorEmail() above, for the same reason.
    function isInvitedMonitorEmail() {
      return isSignedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/monitorInvites/$(request.auth.token.email.lower()));
    }

    function isMonitor() {
      return isMonitorEmail() || isMonitorDoc() || isMonitorFlag() || isInvitedMonitorEmail();
    }

    // A claimedStudentId written onto a user's own profile is only
    // legitimate if a matching claims/{id} doc already names them as
    // its owner — i.e. it came from the atomic claim transaction in
    // auth.js, not a direct profile edit. Two variants because
    // `resource` doesn't exist yet on create.
    function claimedIdOnCreateIsValid() {
      return !('claimedStudentId' in request.resource.data) ||
        (request.resource.data.claimedStudentId is string &&
         get(/databases/$(database)/documents/claims/$(request.resource.data.claimedStudentId)).data.uid == request.auth.uid);
    }

    function claimedIdOnUpdateIsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedStudentId']) ||
        (request.resource.data.claimedStudentId is string &&
         get(/databases/$(database)/documents/claims/$(request.resource.data.claimedStudentId)).data.uid == request.auth.uid);
    }

    // ================================================================
    // monitors/{uid} — existence of the doc IS the monitor role.
    // ================================================================
    match /monitors/{uid} {
      allow read: if isSignedIn();
      allow write: if isMonitor();
    }

    // ================================================================
    // monitorInvites/{email} — doc ID = the invited address, lower-
    // cased. Public read: this is the "Monitors" list shown at the
    // bottom of the main page to every visitor, signed in or not,
    // same openness as students/teachers. Only an existing monitor
    // can create one, only for a real-looking @gmail.com address, and
    // the stored `email` field must match the doc ID exactly — so
    // there's no way to create an invite at one address that actually
    // grants a different one. No update: revoking access is a
    // delete-and-recreate, not an edit, so there's no path that
    // silently changes who a standing invite belongs to.
    // ================================================================
    match /monitorInvites/{email} {
      allow read: if true;
      allow create: if isMonitor() &&
        email == email.lower() &&
        email.matches('^[^@\\s]+@gmail\\.com$') &&
        request.resource.data.email == email;
      allow update: if false;
      allow delete: if isMonitor();
    }

    // ================================================================
    // users/{uid} — profile docs
    // ================================================================
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isMonitor());

      allow create: if isSignedIn() && request.auth.uid == uid &&
        claimedIdOnCreateIsValid() &&
        (isMonitor() || !('monitor' in request.resource.data) || request.resource.data.monitor != true);

      allow update: if isSignedIn() && (
        isMonitor() ||
        (request.auth.uid == uid && claimedIdOnUpdateIsValid())
      );

      allow delete: if false;
    }

    // ================================================================
    // students/{studentId} — the class directory. Monitor-managed.
    // Public read: this mirrors the fact that the old students.js
    // array shipped to every visitor's browser regardless of sign-in.
    // Only classmate-appropriate fields belong in these docs — see
    // section 6 of the project spec for what's safe to store here.
    // ================================================================
    // ================================================================
    // avatars/{uid} — premade avatar IDs only. The ID is not sensitive,
    // so directory cards can read avatars publicly; only the account
    // owner can write its own avatar document.
    // ================================================================
    match /avatars/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }


    // Teachers — public read, monitor-only write. Same pattern as
    // students: the roster is public information, only monitors manage it.
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // ================================================================
    // claims/{studentId} — one doc per student identity, doc ID =
    // studentId. Firestore itself guarantees only one "create" can
    // ever succeed per student: a second attempt against an existing
    // doc is a write of type "update", which is blocked below unless
    // it's a monitor resolving a bad claim or the current owner
    // releasing their own claim (switching identity). This is what
    // makes claiming atomic instead of relying on a client-side
    // "check then write" race.
    // ================================================================
    match /claims/{studentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'studentName', 'claimedAt']);

      allow update: if isMonitor();

      allow delete: if isMonitor() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ================================================================
    // Class content. Read: signed-in students (public where the old
    // behavior was public). Write: monitors only.
    // ================================================================

    // Legacy daily task/announcement list — kept for backward
    // compatibility with the existing UI. `assignments` below is the
    // dedicated homework collection for the new system.
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // Per-student homework completion, split out from the shared
    // assignment doc so a student's write can only ever touch their
    // own row, never anyone else's and never the assignment itself.
    match /assignmentStatus/{statusId} {
      allow read: if isMonitor() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isMonitor() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isMonitor();
    }
    
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /archiveMaterials/{materialId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /quickLinks/{linkId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // Pitch (football) — Red vs Blue, every Friday PE. Public read,
    // monitor-only write, same openness as quickLinks/students/etc.
    match /pitchMatches/{matchId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /pitchTeams/{teamId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // Pitch performances — one doc per player per match, id =
    // "YYYY-MM-DD_playerId". Everyone can read (the last-match card on
    // the Pitch page is public); only a monitor can write one. There's
    // no student-submitted / pending path any more — a monitor logging
    // a stat line counts immediately.
    match /pitchPerformances/{perfId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // No Firebase Storage on the free plan — gallery docs hold an
    // externally-hosted image URL, not a file.
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /timetable/{docId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isMonitor();
    }

    // ================================================================
    // notifications/{id} — scoped to the recipient. Monitors create
    // them (real class events only); a student can read/ack their own
    // but can never create one addressed to somebody else.
    // ================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if isMonitor();
      allow delete: if isMonitor() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ================================================================
    // activityLogs/{id} — the monitor audit log. Monitor-only,
    // append-only (no update/delete) so it can't be quietly edited
    // after the fact.
    // ================================================================
    match /activityLogs/{logId} {
      allow read: if isMonitor();
      allow create: if isMonitor();
      allow update, delete: if false;
    }
  }
}

