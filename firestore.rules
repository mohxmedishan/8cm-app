rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "mohamedishankunnummal@gmail.com"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        );
    }

    function validTaskData(data) {
      return data.keys().hasOnly([
          "subject",
          "type",
          "detail",
          "due",
          "createdAt"
        ])
        && data.subject is string
        && data.subject.size() > 0
        && data.subject.size() <= 120
        && data.type in ["homework", "announcement"]
        && data.detail is string
        && data.detail.size() > 0
        && data.detail.size() <= 1000
        && data.due is string
        && data.due.size() > 0
        && data.due.size() <= 80
        && data.createdAt is timestamp;
    }

    function profileOwnWrite(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function claimedIdentityMatchesAfterWrite(userId) {
      return request.resource.data.claimedStudentId is string
        && request.resource.data.claimedStudentName is string
        && exists(/databases/$(database)/documents/studentClaims/$(request.resource.data.claimedStudentId))
        && getAfter(
          /databases/$(database)/documents/studentClaims/$(request.resource.data.claimedStudentId)
        ).data.uid == userId;
    }

    match /tasks/{taskId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && validTaskData(request.resource.data);

      allow update: if isAdmin()
        && validTaskData(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "subject",
          "type",
          "detail",
          "due"
        ]);

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if profileOwnWrite(userId)
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "admin",
          "claimedStudentId",
          "claimedStudentName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.admin == false
        && (
          !request.resource.data.keys().hasAny(["claimedStudentId"])
          || claimedIdentityMatchesAfterWrite(userId)
        );

      allow update: if profileOwnWrite(userId)
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "admin",
          "claimedStudentId",
          "claimedStudentName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.admin == resource.data.admin
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            resource.data.keys().hasAny(["claimedStudentId"])
            && request.resource.data.claimedStudentId == resource.data.claimedStudentId
            && request.resource.data.claimedStudentName == resource.data.claimedStudentName
          )
          ||
          (
            !resource.data.keys().hasAny(["claimedStudentId"])
            && (
              !request.resource.data.keys().hasAny(["claimedStudentId"])
              || claimedIdentityMatchesAfterWrite(userId)
            )
          )
        );

      allow delete: if false;
    }

    match /studentClaims/{studentId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/studentClaims/$(studentId))
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.claimedStudentId == studentId;

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
